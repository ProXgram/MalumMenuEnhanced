<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <DebugType>embedded</DebugType>
        <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/..'))=/_/MalumMenuEnhanced</PathMap>

        <AssemblyName>MalumMenuEnhanced</AssemblyName>
        <Product>MalumMenu Enhanced</Product>
        <Title>MalumMenu Enhanced</Title>
        <AssemblyTitle>MalumMenu Enhanced</AssemblyTitle>
        <Company>Rifegul</Company>
        <VersionPrefix>1.0</VersionPrefix>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <Description>Rifegul's enhanced Among Us 19 edition, based on MalumMenu.</Description>
        <Authors>Rifegul; scp222thj; astra1dev</Authors>
        <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    </PropertyGroup>

    <PropertyGroup Condition="'$(GuestKillExperiment)' == 'true'">
        <DefineConstants>$(DefineConstants);GUEST_KILL_EXPERIMENT</DefineConstants>
        <VersionSuffix>guest-test</VersionSuffix>
    </PropertyGroup>

    <PropertyGroup Condition="'$(JudgeRoleExperiment)' == 'true'">
        <DefineConstants>$(DefineConstants);GUEST_KILL_EXPERIMENT;JUDGE_ROLE_EXPERIMENT</DefineConstants>
        <VersionSuffix>judge-test</VersionSuffix>
    </PropertyGroup>

    <!--<ItemGroup>
        <EmbeddedResource Include=".\Assets\**" />
    </ItemGroup>-->

    <ItemGroup>
        <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.735" Private="false" ExcludeAssets="runtime;native" />
        <PackageReference Include="AmongUs.GameLibs.Steam" Version="2026.9.29" PrivateAssets="all" />

        <PackageReference Include="BepInEx.AutoPlugin" Version="1.1.0" PrivateAssets="all" />
        <PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.1.0-rc.1" PrivateAssets="all" ExcludeAssets="runtime" />
    </ItemGroup>

    <Target Name="Copy" AfterTargets="Build" Condition="'$(AmongUs)' != ''">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AmongUs)/BepInEx/plugins/" UseSymboliclinksIfPossible="true" />
    </Target>
</Project>
